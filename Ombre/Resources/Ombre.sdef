<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!--
  What agents (apps, scripts, the ombre command) may ask Ombre, through Apple
  Events: no network port. Only the tabs of the front normal window: never a
  private window, Little Ombre, passwords or the keychain. Off until allowed in
  Settings › General; each app is then asked about once per session (see
  AgentControl.swift). No standard suite: it would show every window,
  private ones too. Replies are JSON text.
-->
<dictionary title="Ombre Terminology">
    <suite name="Ombre Suite" code="Ombr" description="Tabs of Ombre's front window, for agents. Allowed in Settings › General; each app asks once per session.">
        <command name="list tabs" code="OmbrLsTb" description="The spaces and their tabs, as JSON.">
            <cocoa class="OmbreListTabsCommand"/>
            <result type="text" description="JSON: spaces, each with its tabs (id, title, address, kind, active)."/>
        </command>
        <command name="open address" code="OmbrOpAd" description="Opens an http or https address in a new tab of the active space.">
            <cocoa class="OmbreOpenAddressCommand"/>
            <direct-parameter type="text" description="The address."/>
            <result type="text" description="JSON: the new tab."/>
        </command>
        <command name="activate tab" code="OmbrAcTb" description="Shows a tab (and its space).">
            <cocoa class="OmbreActivateTabCommand"/>
            <direct-parameter type="text" description="The tab's id, from list tabs."/>
            <result type="text" description="JSON: the tab."/>
        </command>
        <command name="close tab" code="OmbrClTb" description="Closes a tab.">
            <cocoa class="OmbreCloseTabCommand"/>
            <direct-parameter type="text" description="The tab's id, from list tabs."/>
            <result type="text" description="JSON: the tab closed."/>
        </command>
        <command name="read tab" code="OmbrRdTb" description="The title, address and text of a tab's web page (the text cut at 100,000 characters), once it has loaded (10 seconds at most).">
            <cocoa class="OmbreReadTabCommand"/>
            <direct-parameter type="text" optional="yes" description="The tab's id, from list tabs; the active tab without one."/>
            <result type="text" description="JSON: id, title, address, text, truncated."/>
        </command>
        <command name="capture tab" code="OmbrCpTb" description="An image of a tab's web page as it shows (PNG, at most 2560 pixels wide; videos and 3D may come out blank), once it has loaded (10 seconds at most).">
            <cocoa class="OmbreCaptureTabCommand"/>
            <direct-parameter type="text" optional="yes" description="The tab's id, from list tabs; the active tab without one."/>
            <result type="text" description="JSON: id, title, address, width, height, png (base64)."/>
        </command>
        <command name="click element" code="OmbrClik" description="Once its page has loaded, clicks the first element a CSS selector matches (waited for 5 seconds at most) in a tab's web page (page actions must be allowed too; the page sees a click from a script).">
            <cocoa class="OmbreClickElementCommand"/>
            <direct-parameter type="text" description="The CSS selector."/>
            <parameter name="in tab" code="OmTb" type="text" optional="yes" description="The tab's id, from list tabs; the active tab without one.">
                <cocoa key="tab"/>
            </parameter>
            <result type="text" description="JSON: id, title, address, element."/>
        </command>
        <command name="fill field" code="OmbrFill" description="Once its page has loaded, fills in the first field a CSS selector matches (waited for 5 seconds at most) in a tab's web page, as typing would (never a password field; page actions must be allowed too).">
            <cocoa class="OmbreFillFieldCommand"/>
            <direct-parameter type="text" description="The CSS selector."/>
            <parameter name="to" code="OmVl" type="text" description="The text to fill in (a list's value for a list).">
                <cocoa key="value"/>
            </parameter>
            <parameter name="in tab" code="OmTb" type="text" optional="yes" description="The tab's id, from list tabs; the active tab without one.">
                <cocoa key="tab"/>
            </parameter>
            <result type="text" description="JSON: id, title, address, element."/>
        </command>
        <command name="run javascript" code="OmbrRnJS" description="Runs JavaScript in a tab's web page, apart from the page's own scripts (page actions must be allowed too). The code is an async function's body: return gives its result, await works; 15 seconds at most.">
            <cocoa class="OmbreRunJavaScriptCommand"/>
            <direct-parameter type="text" description="The code."/>
            <parameter name="in tab" code="OmTb" type="text" optional="yes" description="The tab's id, from list tabs; the active tab without one.">
                <cocoa key="tab"/>
            </parameter>
            <result type="text" description="JSON: id, title, address, result (any JSON value)."/>
        </command>
    </suite>
</dictionary>
