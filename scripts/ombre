#!/bin/zsh
# ombre — drive Ombre from a terminal, a script or an agent (Apple Events).
#
# Usage:
#   ombre tabs              the spaces and their tabs (JSON)
#   ombre open <address>    opens an http(s) address in a new tab
#   ombre show <tab id>     shows a tab (and its space)
#   ombre close <tab id>    closes a tab
#   ombre read [<tab id>]   title, address and text of a page (the active tab without an id)
#   ombre capture [<tab id>] [-o <file.png>]
#                           an image of a page as it shows (PNG); prints the file's path
#                           (without -o: in $TMPDIR/ombre-captures, never the current folder)
#   ombre click <css selector> [-t <tab id>]
#                           clicks the first element it matches
#   ombre fill <css selector> <text> [-t <tab id>]
#                           fills in that field as typing would (never a password field)
#   ombre js <code> [-t <tab id>]
#                           runs JavaScript in the page (an async function's body:
#                           return gives the result, as JSON)
#   ombre back [-t <tab id>], ombre forward [-t <tab id>], ombre reload [-t <tab id>]
#                           goes back, forward or reloads (never a page that would
#                           send a form again), then waits for the page to load
#   ombre wait [<css selector>] [-t <tab id>] [--timeout <seconds>]
#                           waits for the load started since the last command on
#                           the tab, or starting within a second (after a click on a
#                           link); then, with a selector, for an element to match.
#                           10 s at most, --timeout up to 60. Reads the page only.
#   For fill and js, - reads the text or the code from the standard input
#   (for fill, without its last newline).
#   Without -t: the active tab. click, fill and js also need Settings › General ›
#   Allow agents to act in pages.
#   read, capture, click, fill, back, forward and reload wait for the page to load
#   (10 s at most); click and fill wait up to 5 s for an element to match (15 s in
#   all). js doesn't wait.
#   When the page's last load failed, their reply has a loadError (why, in English).
#
# First allow it in Ombre › Settings › General › Allow agents to control Ombre.
# macOS then asks once to let this terminal control Ombre (Automation), and
# Ombre asks once per session. Never private windows, Little Ombre or passwords.
# Installed in ~/.local/bin by scripts/install.sh. OMBRE_APP_ID picks another
# Ombre (com.barto95100.ora.dev for the Debug app).

set -euo pipefail

app_id=${OMBRE_APP_ID:-com.barto95100.ora}
script=$0

usage() {
    sed -n '4,35p' "$script" | sed 's/^# \{0,1\}//' >&2
    exit "${1:-2}"
}

[[ $# -ge 1 ]] || usage

case $1 in
    tabs) code=LsTb; [[ $# -eq 1 ]] || usage ;;
    open) code=OpAd; [[ $# -eq 2 ]] || usage ;;
    show) code=AcTb; [[ $# -eq 2 ]] || usage ;;
    close) code=ClTb; [[ $# -eq 2 ]] || usage ;;
    read) code=RdTb; [[ $# -le 2 ]] || usage ;;
    capture)
        code=CpTb
        shift
        tab=""
        output=""
        while [[ $# -gt 0 ]]; do
            case $1 in
                -o) [[ $# -ge 2 ]] || usage; output=$2; shift 2 ;;
                -*) usage ;;
                *) [[ -z $tab ]] || usage; tab=$1; shift ;;
            esac
        done
        set -- capture "$tab"
        ;;
    click|fill|js)
        command=$1
        shift
        tab=""
        words=()
        while [[ $# -gt 0 ]]; do
            case $1 in
                -t) [[ $# -ge 2 ]] || usage; tab=$2; shift 2 ;;
                *) words+=("$1"); shift ;;
            esac
        done
        case $command in
            click) code=Clik; [[ ${#words} -eq 1 ]] || usage ;;
            fill) code=Fill; [[ ${#words} -eq 2 ]] || usage ;;
            js) code=RnJS; [[ ${#words} -eq 1 ]] || usage ;;
        esac
        # From the standard input: kept out of the shell's history.
        # (The dot keeps its last newlines, which $( ) would drop.)
        if [[ ${words[-1]} == - && $command != click ]]; then
            input=$(cat; print -n .)
            words[-1]=${input%.}
            # As echo ends a line: one last newline isn't part of a field's text.
            [[ $command != fill ]] || words[-1]=${words[-1]%$'\n'}
        fi
        # The selector or the code, then the text to fill in, then the tab.
        set -- "$command" "${words[1]}" "${words[2]-}" "$tab"
        ;;
    back|forward|reload)
        command=$1
        shift
        tab=""
        while [[ $# -gt 0 ]]; do
            case $1 in
                -t) [[ $# -ge 2 && -z $tab ]] || usage; tab=$2; shift 2 ;;
                *) usage ;;
            esac
        done
        case $command in
            back) code=GoBk ;;
            forward) code=GoFw ;;
            reload) code=Rlod ;;
        esac
        set -- "$command" "$tab"
        ;;
    wait)
        code=Wait
        shift
        tab=""
        selector=""
        timeout=""
        while [[ $# -gt 0 ]]; do
            case $1 in
                -t) [[ $# -ge 2 && -z $tab ]] || usage; tab=$2; shift 2 ;;
                --timeout) [[ $# -ge 2 && -z $timeout ]] || usage; timeout=$2; shift 2 ;;
                *) [[ -z $selector ]] || usage; selector=$1; shift ;;
            esac
        done
        if [[ -n $timeout && ! ( $timeout == <-> && $timeout -ge 1 && $timeout -le 60 ) ]]; then
            print -r -- "The timeout must be a whole number of seconds, 1 to 60." >&2
            exit 2
        fi
        # The selector, the timeout, then the tab.
        set -- wait "$selector" "$timeout" "$tab"
        ;;
    -h|--help|help) usage 0 ;;
    *) usage ;;
esac

# Raw event codes (Ombre.sdef): no dictionary needed to compile the script,
# and the argument goes as data, never as script text.
# Errors as osascript writes them, without its "execution error:" prefix.
if ! reply=$(osascript - "$app_id" "$code" "${2-}" "${3-}" "${4-}" 2>&1 <<'APPLESCRIPT'
on run argv
    set appID to item 1 of argv
    set eventCode to item 2 of argv
    set argument to item 3 of argv
    set value to item 4 of argv
    set tabID to item 5 of argv
    -- A wait can last a minute, after the user's question (100 s at most).
    with timeout of 180 seconds
    tell application id appID
        if eventCode is "Wait" then
            if value is "" then return «event OmbrWait» argument given «class OmTb»:tabID
            return «event OmbrWait» argument given «class OmTb»:tabID, «class OmTO»:(value as integer)
        end if
        if eventCode is "GoBk" then
            if argument is "" then return «event OmbrGoBk»
            return «event OmbrGoBk» argument
        end if
        if eventCode is "GoFw" then
            if argument is "" then return «event OmbrGoFw»
            return «event OmbrGoFw» argument
        end if
        if eventCode is "Rlod" then
            if argument is "" then return «event OmbrRlod»
            return «event OmbrRlod» argument
        end if
        if eventCode is "Clik" then
            if tabID is "" then return «event OmbrClik» argument
            return «event OmbrClik» argument given «class OmTb»:tabID
        end if
        if eventCode is "Fill" then
            if tabID is "" then return «event OmbrFill» argument given «class OmVl»:value
            return «event OmbrFill» argument given «class OmVl»:value, «class OmTb»:tabID
        end if
        if eventCode is "RnJS" then
            if tabID is "" then return «event OmbrRnJS» argument
            return «event OmbrRnJS» argument given «class OmTb»:tabID
        end if
        if eventCode is "LsTb" then return «event OmbrLsTb»
        if eventCode is "OpAd" then return «event OmbrOpAd» argument
        if eventCode is "AcTb" then return «event OmbrAcTb» argument
        if eventCode is "ClTb" then return «event OmbrClTb» argument
        if eventCode is "CpTb" then
            if argument is "" then return «event OmbrCpTb»
            return «event OmbrCpTb» argument
        end if
        if argument is "" then return «event OmbrRdTb»
        return «event OmbrRdTb» argument
    end tell
    end timeout
end run
APPLESCRIPT
); then
    print -r -- "${reply#*execution error: }" >&2
    exit 1
fi
if [[ $code != CpTb ]]; then
    print -r -- "$reply"
    exit 0
fi

# The image into its file (plutil reads the JSON), the file's path printed.
# Without -o, out of the current folder: an agent working in a project would
# leave its captures there, ready for a commit.
if [[ -z $output ]]; then
    folder="${TMPDIR:-/tmp}"
    folder="${folder%/}/ombre-captures"
    mkdir -p -m 700 -- "$folder"
    output="$folder/ombre-capture-$(date +%Y%m%d-%H%M%S)-$$.png"
fi
# Decoded beside it first: a failure leaves no empty or half file.
partial="${output}.partial"
trap 'rm -f -- "$partial"' EXIT
if ! print -r -- "$reply" | plutil -extract png raw -o - - | base64 -D > "$partial"; then
    print -r -- "Ombre's reply held no image." >&2
    exit 1
fi
mv -f -- "$partial" "$output"
print -r -- "${output:A}"
# The page shown may be an error: said beside the path.
if load_error=$(print -r -- "$reply" | plutil -extract loadError raw -o - - 2>/dev/null); then
    print -r -- "Load error: $load_error" >&2
fi
